:80 {
	encode zstd gzip

	redir /ldap /ldap/ 308
	redir /log-view /log-view/ 308

	handle /login* {
		reverse_proxy netrig:8080
	}
	handle /logout {
		reverse_proxy netrig:8080
	}
	handle /auth/check {
		reverse_proxy netrig:8080
	}

	handle /ldap/* {
		route {
			request_header -X-NetRig-User
			request_header -X-NetRig-Signature
			forward_auth netrig:8080 {
				uri /auth/check
				copy_headers X-NetRig-User X-NetRig-Signature
				@unauth status 401
				handle_response @unauth {
					redir /login?return={http.request.uri.path} 303
				}
			}
			reverse_proxy ldapmgttooz:8080 {
				header_up X-Forwarded-Prefix /ldap
			}
		}
	}

	handle /log-view/* {
		route {
			request_header -X-NetRig-User
			request_header -X-NetRig-Signature
			forward_auth netrig:8080 {
				uri /auth/check
				copy_headers X-NetRig-User X-NetRig-Signature
				@unauth status 401
				handle_response @unauth {
					redir /login?return={http.request.uri.path} 303
				}
			}
			reverse_proxy log-view:8080 {
				header_up X-Forwarded-Prefix /log-view
			}
		}
	}

	handle {
		reverse_proxy netrig:8080
	}
}
