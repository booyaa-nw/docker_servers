# .env にコピーして値を変更してください（cp .env.example .env）
RADIUS_SECRET=ChangeMeRadiusSecret

# LDAP管理者（cn=admin,dc=asakusa,dc=lab）
LDAP_ADMIN_PASSWORD=ChangeMeLdapAdmin

# FreeRADIUSがLDAP検索に使うサービスアカウント（cn=radius,ou=ServiceAccounts,dc=asakusa,dc=lab）
LDAP_RADIUS_PASSWORD=ChangeMeLdapRadius

# テストユーザー（初回起動時のみ投入されます）
# taro.yamada / NW-Staff
LDAP_USER1_PASSWORD=ChangeMeUser1
# guest01 / NW-Guest
LDAP_USER2_PASSWORD=ChangeMeUser2
