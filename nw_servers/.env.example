# .env にコピーして値を変更してください（cp .env.example .env）
RADIUS_SECRET=ChangeMeRadiusSecret

# LDAP管理者（cn=admin,dc=asakusa,dc=lab）
LDAP_ADMIN_PASSWORD=ChangeMeLdapAdmin

# FreeRADIUSがLDAP検索に使うサービスアカウント（cn=radius,ou=ServiceAccounts,dc=asakusa,dc=lab）
LDAP_RADIUS_PASSWORD=ChangeMeLdapRadius

# テストユーザー（初回起動時のみ投入されます）
# taro.yamada / NW-Staff
LDAP_USER1_PASSWORD=ChangeMeUser1
# guest01 / NW-Guest
LDAP_USER2_PASSWORD=ChangeMeUser2

# Mailpit SMTP証明書名（省略可）。Web画面は http://<PiのIP>/ でアクセスします。
PUBLIC_DOMAIN=nwlab.local
PI_IP=192.0.2.10

# NetRig ポータルの共通認証
NETRIG_ADMIN_PASSWORD=ChangeMeNetRigAdmin
NETRIG_SECRET=replace-with-output-of-openssl-rand-hex-32
LOG_RETENTION_DAYS=30

# ログビューがホスト上で作成するファイルの所有者（id -u / id -g の値）
LOG_VIEW_UID=1000
LOG_VIEW_GID=1000
LOG_VIEW_DATA_PATH=./plugins/log_view/data
LOG_VIEW_MIB_PATH=./plugins/log_view/config/mibs

# Mailpit受信確認API（通常は空欄。Mailpit側の認証を使う場合のみ設定）
MAILPIT_USERNAME=
MAILPIT_PASSWORD=
MAILPIT_POLL_SECONDS=2
