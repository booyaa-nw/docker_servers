# Append to .env. Use a distinct Compose project (-p) for each directory environment.
LDAP_DOMAIN=lab.example.test
LDAP_BASE_DN=dc=lab,dc=example,dc=test
LDAP_ADMIN_PASSWORD=replace-with-unique-admin-password
LAM_BIND_PASSWORD=replace-with-unique-lam-bind-password
LAM_CONFIG_PASSWORD=replace-with-unique-lam-configuration-password
# Set true after configuring LAM's user modules to preserve the UI profile on restart.
LAM_SKIP_PRECONFIGURE=false
FORTIGATE_BIND_PASSWORD=replace-with-unique-fortigate-bind-password
RADIUS_BIND_PASSWORD=replace-with-unique-radius-bind-password
LDAP_TEST_PASSWORD=replace-with-unique-testuser-password
# Approved lab use: permit simple bind without TLS. Set false to require TLS again.
LDAP_ALLOW_PLAINTEXT=true
